{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RGI Sidecar Example",
  "version": "0.1.0",
  "identifier": "com.rgi.sidecar-example",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RGI Sidecar Example",
        "width": 900,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
